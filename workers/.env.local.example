# Opticon Worker - Local Development (.env.local)
# Copy this to .env and modify as needed.

# 1. Socket Connectivity
SESSION_ID=your-session-id
AGENT_ID=your-agent-id
SOCKET_URL=http://localhost:3000

# 2. LLM Provider (Free/Local)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1

# 3. Sandbox (E2B)
E2B_API_KEY=your-e2b-api-key
# SANDBOX_ID=optional-reconnect-id

# 4. Diagnostics
PYTHONUNBUFFERED=1
ENABLE_MOCK_LLM=false
